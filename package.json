{
  "name": "lode",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=10.0.0",
    "npm": ">=6.0.0"
  },
  "dependencies": {
    "cross-env": "^7.0.3",
    "lodash": "^4.17.21",
    "react": "^16.14.0",
    "react-dom": "^16.14.0",
    "react-redux": "^7.2.9",
    "react-scripts": "4.0.3",
    "redux": "^4.2.1",
    "redux-thunk": "^2.4.2",
    "socket.io-client": "^2.5.0",
    "sass": "^1.32.13"
  },
  "scripts": {
    "start": "cross-env NODE_ENV=development NODE_OPTIONS=--openssl-legacy-provider react-scripts start",
    "server": "nodemon ./server/index.js",
    "server:frontend": "cross-env NODE_ENV=local NODE_OPTIONS=--openssl-legacy-provider react-scripts start",
    "dev": "concurrently \"npm run server:frontend\" \"nodemon ./server/index.js\"",
    "build": "cross-env NODE_OPTIONS=--openssl-legacy-provider react-scripts build",
    "test": "cross-env NODE_OPTIONS=--openssl-legacy-provider react-scripts test",
    "eject": "react-scripts eject"
  },
  "eslintConfig": {
    "extends": "react-app"
  },
  "browserslist": [
    ">0.2%",
    "not dead",
    "not ie <= 11",
    "not op_mini all"
  ],
  "devDependencies": {
    "concurrently": "^5.3.0",
    "nodemon": "^2.0.22"
  }
}
